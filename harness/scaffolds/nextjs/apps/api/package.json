{
  "name": "api",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test src/app.test.ts",
    "worker:dev": "wrangler dev --config wrangler.jsonc --env-file ../../.env",
    "worker:deploy": "wrangler deploy --config wrangler.jsonc"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.1",
    "@supabase/supabase-js": "^2.58.0",
    "hono": "^4.13.3"
  },
  "devDependencies": {
    "@types/node": "^22.18.0",
    "tsx": "^4.23.1",
    "typescript": "^5.9.2",
    "wrangler": "^4.125.0"
  }
}
