{
  "schemaVersion": "1",
  "id": "cross-tenant-denial",
  "title": "A signed-in user persists an item and never sees another account's row",
  "viewport": { "width": 1280, "height": 720 },
  "steps": [
    {
      "id": "open-sign-in",
      "title": "Open the sign-in page",
      "action": { "kind": "goto", "path": "/sign-in" },
      "assertions": [
        { "kind": "visible", "locator": { "by": "role", "role": "button", "name": "Sign in" } }
      ]
    },
    {
      "id": "fill-email",
      "title": "Enter the first account's email",
      "action": {
        "kind": "fill",
        "locator": { "by": "label", "label": "Email" },
        "value": "owner@example.com"
      },
      "assertions": []
    },
    {
      "id": "fill-password",
      "title": "Enter the first account's password",
      "action": {
        "kind": "fill",
        "locator": { "by": "label", "label": "Password" },
        "value": "password123"
      },
      "assertions": []
    },
    {
      "id": "submit-and-assert-tenancy",
      "title": "Sign in, see own rows, and never the other account's row",
      "action": {
        "kind": "click",
        "locator": { "by": "role", "role": "button", "name": "Sign in" }
      },
      "assertions": [
        { "kind": "visible", "locator": { "by": "text", "text": "First item" } },
        { "kind": "visible", "locator": { "by": "text", "text": "Second item" } },
        { "kind": "hidden", "locator": { "by": "text", "text": "Another account's item" } }
      ]
    },
    {
      "id": "fill-new-item",
      "title": "Enter a new item title",
      "action": {
        "kind": "fill",
        "locator": { "by": "label", "label": "New item" },
        "value": "Browser-created item"
      },
      "assertions": []
    },
    {
      "id": "persist-new-item",
      "title": "Persist the item through the authenticated web path",
      "action": {
        "kind": "click",
        "locator": { "by": "role", "role": "button", "name": "Add item" }
      },
      "assertions": [
        { "kind": "visible", "locator": { "by": "text", "text": "Browser-created item" } },
        { "kind": "hidden", "locator": { "by": "text", "text": "Another account's item" } }
      ]
    }
  ]
}
