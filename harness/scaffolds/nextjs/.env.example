# Copy to .env — or just run `pnpm db:start`, which copies this file and then
# fills in the three values only a running stack knows: the API URL, whose port
# is allocated per project, and the two keys the stack generates. For a project
# created by the platform, its credential bridge writes the same three (ADR
# 0034), resolved only into the dev-server subprocess. Either way .env is never
# committed.
#
# `pnpm db:start` also appends SUPABASE_PROJECT_ID and one block of
# SUPABASE_*_PORT values, which is what keeps two projects from colliding on
# 54321. They are deliberately absent here: that absence is how the allocator
# knows this workspace has not been assigned a block yet.

# Left blank on purpose: the URL carries this project's allocated API port, so
# a default here would be wrong for every project but the first
# (harness/stacks/supabase.md, "never hard-code 54321").
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Bypasses row level security entirely. Admin, cron and webhook paths only —
# never a handler serving a browser request (ADR 0038).
SUPABASE_SERVICE_ROLE_KEY=

# The web tier owns the port the preview probes; the API tier takes this one.
API_PORT=3001
