# Real values are written by the platform's credential bridge (ADR 0034) when
# a project is provisioned, and resolved only into the dev-server subprocess —
# never committed. This file documents the contract; it is not read at runtime.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
