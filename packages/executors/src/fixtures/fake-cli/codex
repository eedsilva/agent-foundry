#!/usr/bin/env node
// Fake Codex CLI (#416): speaks `codex exec --json` — prompt on stdin, JSONL
// events on stdout, final message written to --output-last-message.
import { writeFile } from 'node:fs/promises';
import { argValue, readStdin, respond } from './fake-cli-core.mjs';

const argv = process.argv.slice(2);
if (argv.includes('--version')) {
  console.log('fake-codex 1.0.0');
  process.exit(0);
}

try {
  const prompt = await readStdin();
  const artifact = await respond(prompt);
  const text = JSON.stringify(artifact);
  const outputFile = argValue(argv, '--output-last-message');
  if (outputFile) await writeFile(outputFile, text, 'utf8');
  const model = argValue(argv, '--model') ?? 'fake-codex-model';
  console.log(JSON.stringify({ type: 'thread.started', thread_id: 'fake-thread', model }));
  console.log(JSON.stringify({ type: 'turn.started' }));
  console.log(
    JSON.stringify({
      type: 'item.completed',
      item: { id: 'fake-item', type: 'agent_message', text },
    }),
  );
  console.log(
    JSON.stringify({
      type: 'turn.completed',
      usage: { input_tokens: 180, cached_input_tokens: 80, output_tokens: 42 },
    }),
  );
} catch (error) {
  console.error(`fake-codex failed: ${error instanceof Error ? error.message : String(error)}`);
  process.exit(1);
}
